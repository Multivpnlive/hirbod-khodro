[Unit]
Description=Hirbod Email Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hirbod-mailer
Group=hirbod-mailer
WorkingDirectory=/opt/hirbod-mailer
EnvironmentFile=/etc/hirbod-mailer/secrets.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/hirbod-mailer/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0027

[Install]
WantedBy=multi-user.target
