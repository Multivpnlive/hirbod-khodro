[Unit]
Description=Hirbod Telegram Backup (manual)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/hirbod/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/hirbod/app/scripts/telegram_backup.py backup
TimeoutStartSec=2h
